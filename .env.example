# --- Identity ---
BOT_NAME=SangAI                 # the AI's display name, used in bridge replies

# --- Slack (Socket Mode) ---
SLACK_APP_TOKEN=xapp-...        # App-level token, Socket Mode (Basic Information -> App-Level Tokens)
SLACK_BOT_TOKEN=xoxb-...        # Bot User OAuth Token (OAuth & Permissions)

# --- Claude CLI invocation (all optional; defaults shown) ---
# CC_CLAUDE_BIN=claude
# CC_PERMISSION_MODE=acceptEdits       # or default / plan
# CC_ADD_DIR=                          # cwd + --add-dir for claude (default: this repo)
# CC_AGENT_TIMEOUT_S=600

# --- Session continuity ---
# CC_SESSION_CONTINUATION_WINDOW_S=7200          # reuse a recent channel session (2h)

# --- Access control ---
# Comma-separated Slack user IDs allowed to reach Claude. Everyone else gets one
# of 20 random "still warming up" replies (see bridge/unauthorized.py).
# Empty = allow everyone, so set this before inviting the bot anywhere shared.
SLACK_ALLOWED_USERS=U0XXXXXXXXX

# --- Misc ---
# BRIDGE_LOG_LEVEL=INFO
